getgenv().Settings = {
    Speed = 28, -- speed default 16
    JumpPower = 70, -- jump default 50
    InfJump = false,
    NoClip = false
}

-- GUI SIMPLE
local gui = Instance.new("ScreenGui", game.CoreGui)
gui.Name = "ParkourHub"

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0, 180, 0, 220)
frame.Position = UDim2.new(0.05, 0, 0.3, 0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.BorderSizePixel = 0
Instance.new("UICorner", frame).CornerRadius = UDim.new(0,12)

local function buatTombol(text, posY, callback)
    local btn = Instance.new("TextButton", frame)
    btn.Size = UDim2.new(0.85, 0, 0, 32)
    btn.Position = UDim2.new(0.075, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    Instance.new("UICorner", btn)
    btn.MouseButton1Click:Connect(callback)
    return btn
end

buatTombol("Speed ON/OFF", 15, function()
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.WalkSpeed == 16 then hum.WalkSpeed = Settings.Speed else hum.WalkSpeed = 16 end
    end
end)

buatTombol("JumpPower ON/OFF", 55, function()
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.JumpPower == 50 then hum.JumpPower = Settings.JumpPower else hum.JumpPower = 50 end
        hum.UseJumpPower = true
    end
end)

